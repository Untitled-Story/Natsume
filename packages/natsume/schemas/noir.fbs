// NOIR 1.0. Version reset at T5; old beta packages must be recompiled.
// Beta schema: changes are recorded in docs/temp; regenerate consumer bindings.
namespace Noa.IR;

struct Vec2 { x:float; y:float; }
struct Vec3 { x:float; y:float; z:float; }
struct Vec4 { x:float; y:float; z:float; w:float; }
struct Quaternion { x:float; y:float; z:float; w:float; }
struct Color { r:float; g:float; b:float; a:float; }

// All entity IDs are package-local uint32, nonzero and globally unique.
// Ref 0 means absent, never a vector index. IDs are stable for fixed inputs.
enum AssetKind:ubyte { Unknown, Image, Mesh, ShaderData, Sprite, SourceData }
enum CurveDomain:ubyte { Seconds, Normalized }
enum WrapMode:ubyte { Clamp, Loop, PingPong, UnitySerialized }
enum Interpolation:ubyte { Step, Linear, CubicHermite, WeightedBezier }
enum ScalarMode:ubyte { Constant, Curve, TwoConstants, TwoCurves }
enum GradientMode:ubyte { Blend, Fixed, PerceptualBlend }
enum ColorMode:ubyte { Constant, Gradient, TwoColors, TwoGradients, RandomColor }
enum Space:ubyte { Local, World, Custom }
enum ScalingMode:ubyte { Hierarchy, Local, Shape }
enum Projection:ubyte { Perspective, Orthographic, Custom }
enum FovAxis:ubyte { Vertical, Horizontal }
enum AspectMode:ubyte { FromViewport, Fixed }
enum CameraPolicy:ubyte { HostRequired, Embedded, SourcePreserved }
enum BlendFactor:ubyte { Zero, One, SrcColor, OneMinusSrcColor, SrcAlpha, OneMinusSrcAlpha, DstColor, OneMinusDstColor, DstAlpha, OneMinusDstAlpha }
enum BlendOp:ubyte { Add, Subtract, ReverseSubtract, Min, Max }
enum CompareOp:ubyte { Never, Less, Equal, LessEqual, Greater, NotEqual, GreaterEqual, Always }
enum CullMode:ubyte { None, Front, Back }
enum ColorSpace:ubyte { Linear, SRGB, Unspecified }
enum FilterMode:ubyte { Nearest, Linear, Trilinear }
enum AddressMode:ubyte { Clamp, Repeat, Mirror }
enum MaterialModel:ubyte {
  Unknown, ParticleUnlit, ParticleAddAlpha, ParticleMultiply,
  // Unity legacy particle shaders: 2 * vertexColor * tint * texture, alpha saturated.
  LegacyParticleAdditive, LegacyParticleAlphaBlend, SpriteDefault, UIDefault, TextureVertexColor, UnityShader
}
enum RenderMode:ubyte { Billboard, StretchedBillboard, HorizontalBillboard, VerticalBillboard, Mesh, None }
enum Alignment:ubyte { View, World, Local, Facing, Velocity }
enum ParticleSort:ubyte { None, Distance, OldestFirst, YoungestFirst, Depth }
enum MaskInteraction:ubyte { None, VisibleInside, VisibleOutside }
enum SeedMode:ubyte { Fixed, PerInstance }
enum ActionKind:ubyte { ApplyClip, PlayClip, StopEmission, ClearParticles, SetActive }
enum AnimationProperty:ushort {
  Unknown, NodeActive, NodePosition, NodeRotation, NodeScale,
  MaterialTint, MaterialFloat, ParticleParameter, CameraFov,
  CameraOrthoSize, CameraNear, CameraFar, CameraActive, RendererEnabled,
  RendererMaterial, RendererMesh, MaterialTexture,
  RectAnchoredPosition, RectSizeDelta, RectAnchorMin, RectAnchorMax, RectPivot,
  RendererMaterialTint, RendererMaterialFloat, RendererTextureST, ComponentEnabled,
  ParticleColor, ParticleCustomColor, ParticleLoop, SpriteColor, SourceBinding
}
enum ParticleParameter:ushort {
  Unknown, StartLifetime, StartSpeed, StartSizeX, StartSizeY, StartSizeZ,
  StartRotationX, StartRotationY, StartRotationZ, GravityMultiplier,
  RateOverTime, RateOverDistance, VelocityX, VelocityY, VelocityZ,
  NoiseStrengthX, NoiseStrengthY, NoiseStrengthZ, SpeedLimit
}

// Slope units = value / key-time unit. Segment interpolation is on the left key.
struct FloatKey {
  time:float; value:float; in_slope:float; out_slope:float;
  in_weight:float; out_weight:float;
  interpolation:Interpolation; weighted_in:bool; weighted_out:bool;
}
struct BoolKey { time:float; value:bool; }
struct RefKey { time:float; ref_id:uint; }
struct RgbKey { time:float; r:float; g:float; b:float; }
struct AlphaKey { time:float; alpha:float; }

table ScalarCurve {
  domain:CurveDomain;
  pre_wrap:WrapMode;
  post_wrap:WrapMode;
  keys:[FloatKey] (required);
  // Unity internal infinity codes are not public WrapMode values.
  source_pre_infinity:int; source_post_infinity:int;
}
table ScalarParameter {
  mode:ScalarMode;
  constant_min:float;
  constant_max:float;
  curve_min:ScalarCurve;
  curve_max:ScalarCurve;
  multiplier:float = 1;
}
table VectorParameter { x:ScalarParameter; y:ScalarParameter; z:ScalarParameter; }
table Gradient {
  mode:GradientMode;
  rgb:[RgbKey] (required);
  alpha:[AlphaKey] (required);
  // Source key metadata; Unspecified is not silently replaced with Linear.
  // Blend/Fixed interpolate/select the original numeric values. PerceptualBlend
  // uses Oklab and requires the source key-space semantics.
  key_color_space:ColorSpace = Unspecified;
}
table ColorParameter {
  mode:ColorMode;
  color_min:Color;
  color_max:Color;
  gradient_min:Gradient;
  gradient_max:Gradient;
}

// RGB values/gradient keys retain authored, non-premultiplied values.
// The source project's active space is distinct from texture/key encoding and
// from the host's output space. Unspecified requires the named host input.
table ColorContext {
  project_color_space:ColorSpace = Unspecified;
  host_project_color_space_slot:string;
}

table FeatureRequirement { name:string (required); revision:uint = 1; required:bool = true; }
table SpriteAsset {
  mesh_asset_id:uint; image_asset_id:uint;
  rect:Vec4; texture_rect:Vec4; texture_rect_offset:Vec2; atlas_rect_offset:Vec2;
  pivot:Vec2; border:Vec4; pixels_per_unit:float = 100;
  // Source mapping and packing retained for provenance; NOMS UVs are resolved.
  uv_transform:Vec4; packing_flags:uint; downscale_multiplier:float = 1;
  sampler:Sampler; color_space:ColorSpace = SRGB;
}
table Asset { id:uint; kind:AssetKind; sprite:SpriteAsset; }
table Sampler {
  min_filter:FilterMode = Linear; mag_filter:FilterMode = Linear;
  wrap_u:AddressMode = Clamp; wrap_v:AddressMode = Clamp;
}
table TextureBinding {
  slot:string (required); image_id:uint;
  uv_set:ubyte; scale:Vec2; offset:Vec2;
  color_space:ColorSpace = SRGB;
  sampler:Sampler;
}
table FloatProperty { name:string (required); value:float; }
table VectorProperty { name:string (required); value:Vec4; }
enum StencilOp:ubyte { Keep, Zero, Replace, IncrementSaturate, DecrementSaturate, Invert, IncrementWrap, DecrementWrap }
table StencilFace { compare:CompareOp = Always; pass:StencilOp; fail:StencilOp; depth_fail:StencilOp; }
table StencilState { reference:ubyte; read_mask:ubyte = 255; write_mask:ubyte = 255; front:StencilFace (required); back:StencilFace (required); }
enum DepthTestSource:ubyte { Fixed, Canvas }
table RenderState {
  depth_test_source:DepthTestSource; stencil:StencilState;
  src_rgb:BlendFactor = SrcAlpha; dst_rgb:BlendFactor = OneMinusSrcAlpha;
  src_alpha:BlendFactor = One; dst_alpha:BlendFactor = OneMinusSrcAlpha;
  rgb_op:BlendOp; alpha_op:BlendOp;
  depth_test:CompareOp = LessEqual; depth_write:bool;
  cull:CullMode;
  color_write_mask:ubyte = 15;
}
table Material {
  id:uint; name:string;
  model:MaterialModel;
  tint:Color;
  textures:[TextureBinding];
  floats:[FloatProperty]; vectors:[VectorProperty];
  render_state:RenderState (required);
  render_queue:int = 3000;
  source_shader:string;
  shader_data_asset_id:uint;
  // Complete authored material when the program needs a Unity source importer.
  source_data:SerializedValue;
}

table Transform { position:Vec3; rotation:Quaternion; scale:Vec3; }
table Node {
  id:uint; name:string;
  parent_id:uint;
  active:bool = true;
  transform:Transform (required);
  layer_mask:uint = 1;
}
table RectLayout {
  anchor_min:Vec2; anchor_max:Vec2; pivot:Vec2;
  anchored_position:Vec3; size_delta:Vec2;
  host_layout_slot:string;
}
// Column-major, column vectors; 16 elements required by semantic validation.
table Matrix4 { values:[float] (required); }
enum GateFit:ubyte { None, Vertical, Horizontal, Fill, Overscan }
enum CameraClear:ubyte { Skybox, SolidColor, DepthOnly, Nothing }
table Camera {
  physical:bool; sensor_size_mm:Vec2; lens_shift:Vec2; focal_length_mm:float;
  gate_fit:GateFit; clear:CameraClear; background:Color;
  hdr:bool; msaa:bool; dynamic_resolution:bool; target_display:uint;

  projection:Projection;
  fov_radians:float = 1.0471976;
  fov_axis:FovAxis;
  ortho_half_height:float = 5;
  near_plane:float = 0.1; far_plane:float = 1000;
  aspect_mode:AspectMode; aspect:float = 1;
  viewport:Vec4;
  culling_mask:uint = 4294967295;
  order:float;
  custom_projection:Matrix4;
}

table Burst {
  time_seconds:float;
  count:ScalarParameter (required);
  cycles:uint = 1; interval_seconds:float;
  probability:float = 1;
}
enum ParticleClock:ubyte { Scaled, Unscaled }
enum StopAction:ubyte { None, Disable, Destroy, Callback }
enum RingBufferMode:ubyte { Disabled, PauseUntilReplaced, LoopUntilReplaced }
enum ParticleCulling:ubyte { Automatic, PauseAndCatchup, Pause, AlwaysSimulate }
enum EmitterVelocityMode:ubyte { Transform, Rigidbody, Custom }
enum GravitySource:ubyte { Physics3D, Physics2D }
table MainModule {
  clock:ParticleClock; stop_action:StopAction; ring_buffer:RingBufferMode;
  ring_buffer_loop_range:Vec2; culling:ParticleCulling;
  emitter_velocity_mode:EmitterVelocityMode; custom_emitter_velocity:Vec3;
  gravity_source:GravitySource;
  host_rigidbody_velocity_slot:string;
  duration_seconds:float = 5;
  loop:bool; prewarm:bool; play_on_enable:bool = true;
  start_delay:ScalarParameter;
  lifetime:ScalarParameter (required);
  speed:ScalarParameter (required);
  color:ColorParameter (required);
  size:VectorParameter (required);
  rotation:VectorParameter (required);
  size_3d:bool; rotation_3d:bool;
  flip_rotation_probability:float;
  gravity_multiplier:ScalarParameter;
  space:Space;
  custom_space_node_id:uint;
  scaling:ScalingMode;
  simulation_speed:float = 1;
  seed_mode:SeedMode;
  seed:uint;
  max_particles:uint = 1000;
  gravity:Vec3;
  host_gravity_slot:string;
}
table EmissionModule {
  rate_over_time:ScalarParameter; rate_over_distance:ScalarParameter;
  bursts:[Burst];
  // Automatic emission only; sub-emitter triggers retain the authored parameters.
  enabled:bool = true;
}
// Shape modes are represented by semantic tables, never Unity enum values.
enum ShapeSweep:ubyte { Random, Loop, PingPong, BurstSpread }
table CircleShape {
  radius:ScalarParameter; arc_radians:float = 6.2831853;
  radius_thickness:float = 1;
  radius_mode:ShapeSweep; radius_speed:ScalarParameter; radius_spread:float;
  arc_mode:ShapeSweep; arc_speed:ScalarParameter; arc_spread:float;
}
enum BoxRegion:ubyte { Volume, Shell, Edge }
// Unit box centered at origin, scaled by ShapeModule.transform.scale.
// Thickness is Unity's per-axis normalized shell thickness, retained for all regions.
table BoxShape { thickness:Vec3; region:BoxRegion; }
table SphereShape { radius:ScalarParameter; radius_thickness:float = 1; hemisphere:bool; }
enum ConeRegion:ubyte { Base, Volume }
table ConeShape {
  radius:ScalarParameter; angle_radians:float; length:float;
  region:ConeRegion;
  radius_thickness:float = 1;
  arc_radians:float = 6.2831853;
  radius_mode:ShapeSweep; radius_speed:ScalarParameter; radius_spread:float;
  arc_mode:ShapeSweep; arc_speed:ScalarParameter; arc_spread:float;
}
// Unity 2022.3 SingleSidedEdge: local X from -half_length to +half_length; direction +Y.
table EdgeShape {
  half_length:ScalarParameter;
  mode:ShapeSweep; speed:ScalarParameter; spread:float;
}
table DonutShape {
  radius:float; tube_radius:float; radius_thickness:float = 1;
  arc_radians:float = 6.2831855; arc_mode:ShapeSweep;
  arc_speed:ScalarParameter; arc_spread:float;
}
enum GeometryPlacement:ubyte { Vertex, Edge, Triangle }
table SpriteShape {
  source_renderer_component_id:uint;
  sprite_asset_id:uint;
  placement:GeometryPlacement; normal_offset:float;
  use_mesh_colors:bool;
  spawn_mode:ShapeSweep; spawn_speed:ScalarParameter; spawn_spread:float;
}
// Sprite sampling uses authored geometry/placement; texture alpha is not a shape mask.
// Rectangle is a unit XY plane centered at origin, direction +Z.
table RectangleShape {}
table MeshShape {
  source_renderer_component_id:uint;
  mesh_asset_id:uint; placement:GeometryPlacement; normal_offset:float; use_mesh_colors:bool;
  use_material_index:bool; material_index:uint;
  spawn_mode:ShapeSweep; spawn_speed:ScalarParameter; spawn_spread:float;
}
table ShapeTexture {
  image_asset_id:uint; clip_channel:ubyte = 3; clip_threshold:float; uv_channel:ubyte;
  color_affects_particles:bool; alpha_affects_particles:bool; bilinear_filtering:bool;
}
union ShapeGeometry { CircleShape, BoxShape, SphereShape, ConeShape, EdgeShape, DonutShape, SpriteShape, RectangleShape, MeshShape }
table ShapeModule {
  texture:ShapeTexture;
  geometry:ShapeGeometry;
  transform:Transform (required);
  align_to_direction:bool;
  random_direction:float; spherical_direction:float; random_position:float;
}
table ColorModule { color:ColorParameter (required); }
table SizeModule { size:VectorParameter (required); separate_axes:bool; }
table RotationModule { angular_velocity:VectorParameter (required); separate_axes:bool; }
table VelocityModule {
  linear:VectorParameter; orbital:VectorParameter; orbital_offset:VectorParameter;
  radial:ScalarParameter; speed_multiplier:ScalarParameter;
  space:Space;
}
table LimitVelocityModule {
  limit:VectorParameter (required); separate_axes:bool;
  space:Space; dampen:float;
  drag:ScalarParameter;
  multiply_drag_by_size:bool; multiply_drag_by_velocity:bool;
}
enum NoiseQuality:ubyte { Low, Medium, High }
table NoiseModule {
  algorithm:string (required); algorithm_revision:uint = 1;
  strength:VectorParameter (required); separate_axes:bool;
  frequency:float = 0.5; damping:bool;
  octaves:ubyte = 1; octave_multiplier:float = 0.5; octave_scale:float = 2;
  quality:NoiseQuality;
  scroll_speed:ScalarParameter;
  remap_enabled:bool; remap:VectorParameter;
  position_amount:ScalarParameter; rotation_amount:ScalarParameter; size_amount:ScalarParameter;
}
enum SheetTime:ubyte { Lifetime, Speed, FPS }
enum SheetAnimation:ubyte { WholeSheet, SingleRow }
enum SheetRow:ubyte { Fixed, Random, MeshIndex }
enum SheetMode:ubyte { Grid, Sprites }
table TextureSheetModule {
  mode:SheetMode; sprite_asset_ids:[uint];
  columns:uint = 1; rows:uint = 1;
  time_mode:SheetTime;
  frame_over_time:ScalarParameter; start_frame:ScalarParameter;
  cycles:float = 1;
  animation:SheetAnimation; row_mode:SheetRow; row:uint;
  fps:float = 30; speed_range:Vec2;
  uv_channel_mask:uint = 1;
  flip_u_probability:float; flip_v_probability:float;
}
enum CustomDataMode:ubyte { Disabled, Vector, Color }
table CustomDataStream {
  slot:ubyte; mode:CustomDataMode;
  vector_components:ubyte;
  vector:[ScalarParameter]; color:ColorParameter;
}
table CustomDataModule { streams:[CustomDataStream] (required); }
// Curves sample normalized speed in speed_range (source units/second),
// not emitter time or particle age. Size is a multiplier; rotation is rad/s.
table SizeBySpeedModule {
  size:VectorParameter (required); separate_axes:bool;
  speed_range:Vec2;
}
table RotationBySpeedModule {
  angular_velocity:VectorParameter (required); separate_axes:bool;
  speed_range:Vec2;
}
// Ordered slots; target 0 preserves a null Unity emitter slot (no emission).
enum SubEmitterEvent:ubyte { Birth, Collision, Death, Trigger, Manual }
// Unity inheritance bits: color=1,size=2,rotation=4,lifetime=8,duration=16.
table SubEmitter { system_component_id:uint; event:SubEmitterEvent; inherit_properties:uint; probability:float = 1; }
table SubEmittersModule { emitters:[SubEmitter] (required); }
enum TrailMode:ubyte { PerParticle, Ribbon }
enum TrailTextureMode:ubyte { Stretch, Tile, DistributePerSegment, RepeatPerSegment, Static }
table TrailsModule {
  mode:TrailMode; ratio:float = 1; lifetime:ScalarParameter (required);
  min_vertex_distance:float; texture_mode:TrailTextureMode; texture_scale:Vec2;
  ribbon_count:uint = 1; shadow_bias:float;
  world_space:bool; die_with_particles:bool; size_affects_width:bool;
  size_affects_lifetime:bool; inherit_particle_color:bool; generate_lighting_data:bool;
  split_sub_emitter_ribbons:bool; attach_ribbons_to_transform:bool;
  color_over_lifetime:ColorParameter (required); width_over_trail:ScalarParameter (required);
  color_over_trail:ColorParameter (required);
}
enum InheritVelocityMode:ubyte { Initial, Current }
table InheritVelocityModule { mode:InheritVelocityMode; multiplier:ScalarParameter (required); }
table LifetimeByEmitterSpeedModule { multiplier:ScalarParameter (required); speed_range:Vec2; }
table ForceModule { force:VectorParameter (required); space:Space; randomize_per_frame:bool; }
table ColorBySpeedModule { color:ColorParameter (required); speed_range:Vec2; }
// Environmental resources are explicit host inputs, never implicit Unity objects.
// An empty slot has no source and no host_slot; ordered null slots are preserved.
enum EnvironmentKind:ubyte { ForceField, Collider3D, Collider2D, Light }
table EnvironmentReference {
  kind:EnvironmentKind; source:SourceReference; source_asset:string; host_slot:string;
}
enum InfluenceFilter:ubyte { LayerMask, List, LayerMaskAndList }
table ExternalForcesModule {
  multiplier:ScalarParameter (required); filter:InfluenceFilter;
  layer_mask:uint = 4294967295; influences:[EnvironmentReference] (required);
  host_force_fields_slot:string;
}
enum CollisionType:ubyte { Planes, World }
enum PhysicsDimension:ubyte { Physics3D, Physics2D }
enum CollisionQuality:ubyte { High, Medium, Low }
// Zero node IDs retain null plane slots. Plane orientation is local +Y.
table CollisionModule {
  type:CollisionType; dimension:PhysicsDimension; planes:[uint] (required);
  dampen:ScalarParameter (required); bounce:ScalarParameter (required);
  lifetime_loss:ScalarParameter (required);
  min_kill_speed:float; max_kill_speed:float; radius_scale:float = 1;
  layer_mask:uint = 4294967295; dynamic_colliders:bool; interior_collisions:bool;
  quality:CollisionQuality; voxel_size:float; max_shapes:uint;
  send_messages:bool; collider_force:float;
  multiply_force_by_size:bool; multiply_force_by_speed:bool; multiply_force_by_angle:bool;
  host_physics_slot:string;
}
enum OverlapAction:ubyte { Ignore, Kill, Callback }
enum ColliderQuery:ubyte { Disabled, One, All }
table TriggerModule {
  inside:OverlapAction; outside:OverlapAction; enter:OverlapAction; exit:OverlapAction;
  query:ColliderQuery; radius_scale:float = 1;
  colliders:[EnvironmentReference] (required);
}
table LightsModule {
  ratio:float; random_distribution:bool; use_particle_color:bool;
  size_affects_range:bool; alpha_affects_intensity:bool; max_lights:uint;
  light:EnvironmentReference (required);
  range_multiplier:ScalarParameter (required); intensity_multiplier:ScalarParameter (required);
}
union ParticleModuleData {
  EmissionModule, ShapeModule, ColorModule, SizeModule, RotationModule,
  VelocityModule, LimitVelocityModule, NoiseModule, TextureSheetModule, CustomDataModule, SizeBySpeedModule, RotationBySpeedModule, SubEmittersModule, TrailsModule, InheritVelocityModule, LifetimeByEmitterSpeedModule, ForceModule, ColorBySpeedModule, ExternalForcesModule, CollisionModule, TriggerModule, LightsModule
}
table ParticleModule { data:ParticleModuleData; }
table ParticleSystem {
  main:MainModule (required);
  modules:[ParticleModule];
}
enum VertexSemantic:ubyte {
  Position, Normal, Color, UV0, UV1, UV2, UV3, Size, Rotation,
  Velocity, AgeNormalized, Custom1, Custom2, Center, VertexId, Tangent, NextTrailCenter, PreviousTrailCenter, PercentageAlongTrail, TrailWidth, AnimBlend, AnimFrame, RotationSpeed, Speed, InverseStartLifetime, StableRandom, VaryingRandom, NoiseSum, NoiseImpulse, MeshIndex, ParticleIndex, ColorPacked, MeshAxisOfRotation
}
table VertexStream { semantic:VertexSemantic; components:ubyte; }
enum MeshDistribution:ubyte { UniformRandom, NonUniformRandom }
table ParticleRenderer {
  mask_interaction:MaskInteraction;
  environment:RenderEnvironment;
  system_component_id:uint;
  materials:[uint] (required);
  mode:RenderMode;
  alignment:Alignment;
  mesh_asset_ids:[uint]; mesh_weights:[float];
  sorting_layer_rank:int; sorting_order:int; sorting_fudge:float;
  sort:ParticleSort;
  pivot:Vec3; flip:Vec3;
  min_size:float; max_size:float = 1;
  camera_velocity_scale:float; velocity_scale:float; length_scale:float = 2;
  allow_roll:bool = true;
  vertex_streams:[VertexStream];
  apply_active_color_space:bool = true;
  normal_direction:float = 1;
  freeform_stretching:bool;
  rotate_with_stretch_direction:bool = true;
  source_sorting_layer_id:int;
  // Material slot 0 draws particles; slot 1 draws trails. No implicit fallback.
  trail_vertex_streams:[VertexStream];
  // Uniform selection ignores mesh_weights.
  mesh_distribution:MeshDistribution;
}
// Custom scripts carry serialized data only. Host factories are never embedded.
table ScriptIdentity {
  assembly:string (required);
  namespace:string (required);
  class_name:string (required);
}
// Preserve non-null unresolved references for diagnostics, never coerce to null.
table SourceReference { guid:string; file_id:long; }
enum ReferenceKind:ubyte { Unknown, Node, Component, Material, Asset, Animation }
table TypedReference { kind:ReferenceKind; id:uint; }
table ReferenceValue { source:SourceReference (required); target:TypedReference; }
enum SpecialFloat:ubyte { NaN, PositiveInfinity, NegativeInfinity }
table SpecialFloatValue { kind:SpecialFloat; }
table NullValue {}
table BooleanValue { value:bool; }
table SignedValue { value:long; }
table UnsignedValue { value:ulong; }
table DoubleValue { value:double; }
table StringValue { value:string (required); }
table ArrayValue { values:[SerializedValue] (required); }
table ObjectValue { fields:[SerializedField] (required); }
union SerializedValueData {
  NullValue, BooleanValue, SignedValue, UnsignedValue, DoubleValue,
  StringValue, ArrayValue, ObjectValue, ReferenceValue, SpecialFloatValue
}
table SerializedValue { data:SerializedValueData; }
table SerializedField {
  name:string (required);
  // Authoritative declared type if available; missing does not mean guessed.
  declared_type:string;
  value:SerializedValue (required);
}
table CustomComponent {
  script:ScriptIdentity;
  source_script:SourceReference (required);
  fields:[SerializedField] (required);
}
// Controller data is declarative; Natsume evaluates conditions, clocks and blending.
enum AnimatorParameterType:ubyte { Float, Int, Bool, Trigger }
table AnimatorParameter { name:string (required); type:AnimatorParameterType; default_float:float; default_int:int; default_bool:bool; }
enum AnimatorConditionMode:ubyte { If, IfNot, Greater, Less, Equals, NotEqual }
table AnimatorCondition { parameter:string (required); mode:AnimatorConditionMode; threshold:float; }
enum AnimatorInterruption:ubyte { None, Source, Destination, SourceThenDestination, DestinationThenSource }
table AnimatorTransition {
  // Destination 0 is legal only for an Exit transition.
  destination_state_id:uint; is_exit:bool;
  conditions:[AnimatorCondition] (required);
  name:string; solo:bool; mute:bool;
  duration:float; fixed_duration:bool; offset:float;
  has_exit_time:bool; exit_time:float;
  interruption:AnimatorInterruption; ordered_interruption:bool; can_transition_to_self:bool;
}
table AnimatorState {
  id:uint; name:string (required);
  // 0 = empty Motion, not an invented empty animation clip.
  animation_id:uint; speed:float = 1; cycle_offset:float;
  write_default_values:bool; tag:string;
  speed_parameter:string; cycle_offset_parameter:string; time_parameter:string;
  transitions:[AnimatorTransition] (required);
}
enum AnimatorLayerBlend:ubyte { Override, Additive }
table AnimatorLayer {
  name:string (required); default_weight:float; blend:AnimatorLayerBlend;
  default_state_id:uint; states:[AnimatorState] (required);
  any_state_transitions:[AnimatorTransition] (required);
  entry_transitions:[AnimatorTransition] (required);
}
enum AnimatorUpdateMode:ubyte { Normal, AnimatePhysics, UnscaledTime }
enum AnimatorCullingMode:ubyte { AlwaysAnimate, CullUpdateTransforms, CullCompletely }
table Animator {
  // Absent means no Controller; keep the Animator for Timeline/host playback.
  source_controller:SourceReference;
  keep_state_on_disable:bool; write_default_values_on_disable:bool;
  update_mode:AnimatorUpdateMode; culling_mode:AnimatorCullingMode;
  parameters:[AnimatorParameter] (required); layers:[AnimatorLayer] (required);
}
// A null playable asset is a real empty Director, with bindings preserved.
enum DirectorWrap:ubyte { Hold, Loop, None }
enum DirectorClock:ubyte { DSP, GameTime, UnscaledGameTime, Manual }
table DirectorBinding { key:SourceReference (required); target:TypedReference; }
table ExposedBinding { name:string (required); target:TypedReference; }
enum TimelineDurationMode:ubyte { BasedOnClips, Fixed }
enum TimelineTrackKind:ubyte { Group, Activation, Animation, Control }
enum TimelinePostPlayback:ubyte { Active, Inactive, Revert, LeaveAsIs }
enum TimelineExtrapolation:ubyte { None, Hold, Loop, PingPong, Continue }
enum TimelineLoop:ubyte { UseSource, On, Off }
table TimelineAnimation {
  animation_id:uint; position:Vec3; euler_radians:Vec3;
  use_track_match_fields:bool; match_target_fields:uint;
  remove_start_offset:bool; apply_foot_ik:bool; loop:TimelineLoop;
}
table TimelineControl {
  exposed_name:string; default_target:TypedReference;
  update_particles:bool; particle_seed:uint; update_directors:bool;
  update_time_control:bool; search_hierarchy:bool; active:bool;
  post_playback:TimelinePostPlayback;
}
union TimelineClipData { TimelineAnimation, TimelineControl }
table TimelineClip {
  name:string; start:double; duration:double; clip_in:double; time_scale:double = 1;
  ease_in:double; ease_out:double; blend_in:double = -1; blend_out:double = -1;
  mix_in:ScalarCurve; mix_out:ScalarCurve;
  blend_in_curve_manual:bool; blend_out_curve_manual:bool;
  pre_extrapolation:TimelineExtrapolation; post_extrapolation:TimelineExtrapolation;
  pre_extrapolation_time:double; post_extrapolation_time:double;
  data:TimelineClipData;
}
table TimelineTrack {
  source:SourceReference (required); name:string (required); kind:TimelineTrackKind; muted:bool;
  // Parent is a track vector index; -1 means root. Children preserve source order.
  parent_index:int = -1; children:[uint] (required); target:TypedReference;
  post_playback:TimelinePostPlayback;
  track_offset:ubyte; position:Vec3; euler_radians:Vec3;
  match_target_fields:uint;
  clips:[TimelineClip] (required);
}
table Timeline {
  duration_mode:TimelineDurationMode; fixed_duration:double;
  roots:[uint] (required); tracks:[TimelineTrack] (required);
}
table PlayableDirector {
  play_on_awake:bool; wrap:DirectorWrap; clock:DirectorClock; initial_time:double;
  // No source asset => no timeline. Unknown tracks/playables are compile errors.
  source_asset:SourceReference;
  timeline:Timeline;
  bindings:[DirectorBinding] (required); exposed_references:[ExposedBinding] (required);
}
table RenderEnvironment {
  cast_shadows:ubyte; receive_shadows:bool; light_probes:ubyte; reflection_probes:ubyte;
}
table MeshFilter { mesh_asset_id:uint; }
table MeshRenderer {
  mesh_filter_component_id:uint; materials:[uint] (required);
  sorting_layer_id:int; sorting_layer_index:int; sorting_order:int;
  environment:RenderEnvironment;
}
enum SpriteDrawMode:ubyte { Simple, Sliced, Tiled }
enum SpriteSortPoint:ubyte { Center, Pivot }
table SpriteRenderer {
  sprite_asset_id:uint; materials:[uint] (required); color:Color;
  flip_x:bool; flip_y:bool; draw_mode:SpriteDrawMode; size:Vec2;
  tile_mode:ubyte; adaptive_mode_threshold:float = 0.5;
  mask_interaction:MaskInteraction;
  sorting_layer_id:int; sorting_layer_index:int; sorting_order:int;
  sort_point:SpriteSortPoint;
}
table SpriteMask {
  sprite_asset_id:uint; alpha_cutoff:float = 0.5;
  custom_range:bool; front_layer_id:int; front_layer_index:int; front_order:int;
  back_layer_id:int; back_layer_index:int; back_order:int;
  sort_point:SpriteSortPoint;
}
enum CanvasMode:ubyte { ScreenOverlay, ScreenCamera, World }
table Canvas {
  mode:CanvasMode; camera_component_id:uint; host_camera_slot:string;
  plane_distance:float; pixel_perfect:bool; override_pixel_perfect:bool;
  override_sorting:bool; sorting_layer_id:int; sorting_order:int;
  additional_shader_channels:uint; target_display:uint; vertex_color_gamma:bool;
}
table CanvasRenderer { cull_transparent_mesh:bool; }
enum ImageType:ubyte { Simple, Sliced, Tiled, Filled }
table UIImage {
  sprite_asset_id:uint; override_sprite_asset_id:uint; material_id:uint;
  color:Color; type:ImageType; preserve_aspect:bool; fill_center:bool = true;
  fill_method:ubyte; fill_amount:float = 1; fill_clockwise:bool = true;
  fill_origin:ubyte; use_sprite_mesh:bool; pixels_per_unit_multiplier:float = 1;
  maskable:bool = true;
}
table UIMask { graphic_component_id:uint; show_graphic:bool = true; }
table RectMask2D { padding:Vec4; softness:Vec2; }
table CanvasGroup { alpha:float = 1; ignore_parent_groups:bool; }

// A preserved native component is data requiring a consumer importer, not an inert replacement.
table UnityComponent { source_object_index:uint; }
union ComponentData { RectLayout, Camera, ParticleSystem, ParticleRenderer, CustomComponent, Animator, MeshRenderer, SpriteRenderer, SpriteMask, Canvas, CanvasRenderer, MeshFilter, UIImage, UIMask, RectMask2D, CanvasGroup, PlayableDirector, UnityComponent }
table Component { id:uint; node_id:uint; enabled:bool = true; data:ComponentData; }

table FloatTrack { curve:ScalarCurve (required); }
table Vector3Track { x:ScalarCurve; y:ScalarCurve; z:ScalarCurve; }
enum RotationEncoding:ubyte { QuaternionComponents, EulerZXY }
table RotationTrack { encoding:RotationEncoding; x:ScalarCurve; y:ScalarCurve; z:ScalarCurve; w:ScalarCurve; }
table ColorTrack { r:ScalarCurve; g:ScalarCurve; b:ScalarCurve; a:ScalarCurve; }
table BoolTrack { keys:[BoolKey] (required); }
table ReferenceTrack { keys:[RefKey] (required); }
table Vector4Track { x:ScalarCurve; y:ScalarCurve; z:ScalarCurve; w:ScalarCurve; }
union TrackData { FloatTrack, Vector3Track, RotationTrack, ColorTrack, BoolTrack, ReferenceTrack, Vector4Track }
enum BindingResolution:ubyte { Resolved, Deferred }
table UnityAnimationBinding {
  root_node_id:uint; source_root_file_id:long;
  path:string (required); class_id:uint; attribute:string (required);
  script:SourceReference; flags:uint; resolution:BindingResolution;
  path_hash:uint; has_path_hash:bool; property_hash:uint; has_property_hash:bool;
  diagnostic:string;
}
table Binding {
  source:UnityAnimationBinding;
  target_id:uint;
  property:AnimationProperty;
  parameter:ParticleParameter;
  property_name:string;
  slot_index:uint;
}
table Track { binding:Binding (required); data:TrackData; }
enum AnimationMessageOptions:ubyte { RequireReceiver, DontRequireReceiver }
// Events carry data only; the host decides how to dispatch them.
table AnimationEvent {
  time_seconds:float; name:string (required); string_parameter:string;
  float_parameter:float; int_parameter:int;
  object_parameter:ReferenceValue;
  message_options:AnimationMessageOptions;
  animator_component_id:uint;
}
table Animation {
  id:uint; name:string;
  duration_seconds:float;
  loop:bool;
  tracks:[Track]; events:[AnimationEvent];
}
table Action {
  kind:ActionKind;
  target_id:uint;
  animation_id:uint;
  active:bool;
}
table EntryPoint {
  id:uint; name:string (required);
  roots:[uint] (required);
  actions:[Action];
  camera_policy:CameraPolicy;
  camera_component_id:uint;
  host_camera_slot:string;
}
table SourceRecord { entity_id:uint; asset_path:string; object_identity:string; property_path:string; }
table Metadata { name:string (required); value:string; }
enum NormalizationStatus:ubyte { Complete, SourcePreserved }
enum DependencyStatus:ubyte { Complete, Unresolved }
enum SourceResolution:ubyte { Object, Asset, ScriptMetadata, Builtin, MissingAsset, MissingObject }
table ExportDiagnostic { severity:string (required); code:string (required); message:string (required); asset:string; property:string; file_id:long; has_file_id:bool; }
table UnitySourceFile { path:string (required); guid:string; asset_id:uint; metadata:SerializedValue; }
table UnitySourceObject {
  file_index:uint; file_id:long; class_id:uint; stripped:bool; type_name:string (required);
  data:SerializedValue (required); script:ScriptIdentity;
}
table UnitySourceReference {
  owner_object_index:uint; property:string (required); source:SourceReference (required);
  resolution:SourceResolution; target_object_index:uint; target_asset_id:uint;
  script:ScriptIdentity;
}
table SourceExport {
  entry_file_index:uint;
  files:[UnitySourceFile] (required); objects:[UnitySourceObject] (required);
  references:[UnitySourceReference] (required); diagnostics:[ExportDiagnostic] (required);
}
table Document {
  normalization:NormalizationStatus; dependencies:DependencyStatus;
  source_export:SourceExport;
  contract_id:string (required);
  format_major:ushort;
  format_minor:ushort;
  semantics_revision:uint = 1;
  features:[FeatureRequirement];
  assets:[Asset]; materials:[Material];
  nodes:[Node] (required); components:[Component];
  animations:[Animation]; entries:[EntryPoint] (required);
  default_entry_id:uint;
  sources:[SourceRecord]; metadata:[Metadata];
  color_context:ColorContext;
}
root_type Document;
file_identifier "NOIR";
file_extension "noir";
