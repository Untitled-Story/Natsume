{
  "name": "@untitled-story/natsume",
  "version": "1.0.0-alpha.2",
  "description": "Runs Unity particle effects, animation and Timeline in the browser on PixiJS v8 and WebGL2",
  "keywords": [
    "pixi",
    "pixijs",
    "unity",
    "particles",
    "vfx",
    "webgl2",
    "timeline",
    "animation"
  ],
  "homepage": "https://natsume.untitled-story.org/",
  "bugs": {
    "url": "https://github.com/Untitled-Story/Natsume/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Untitled-Story/Natsume.git",
    "directory": "packages/natsume"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/natsume.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/natsume.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check:declarations": "node scripts/check-declarations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "flatbuffers": "25.9.23",
    "gl-matrix": "3.4.4"
  },
  "peerDependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "pixi.js": "8.22.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
